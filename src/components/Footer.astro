---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: 'Privacy Policy', href: '/docs/Privacy-Policy.pdf', external: true },
  { label: 'Modern Slavery Statement', href: '/docs/Modern-Slavery-Annual-Statement.pdf', external: true },
  { label: 'Security Advice & Policies', href: '/security-advice-policies' },
  { label: 'Threat Level', href: '/threat-level' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <Logo size="small" />

    <nav class="footer-links" aria-label="Footer navigation">
      {footerLinks.map((link) => (
        <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="socials">
      <a href="https://www.facebook.com" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12"/></svg>
      </a>
      <a href="https://www.linkedin.com" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.4 3H3.6A.6.6 0 0 0 3 3.6v16.8a.6.6 0 0 0 .6.6h16.8a.6.6 0 0 0 .6-.6V3.6a.6.6 0 0 0-.6-.6M8.3 18.3H5.7V9.8h2.6zM7 8.6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m11.3 9.7h-2.6v-4.1c0-1 0-2.3-1.4-2.3s-1.6 1.1-1.6 2.2v4.2H10V9.8h2.5v1.1h.1c.3-.7 1.2-1.4 2.5-1.4 2.7 0 3.2 1.8 3.2 4.1z"/></svg>
      </a>
    </div>
  </div>

  <div class="copyright-bar">
    <p>Copyright &copy; {currentYear} TrustOn | by Alchemedia Group</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 32px 24px;
  }

  .footer-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--gray-text);
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--white);
  }

  .socials {
    display: flex;
    gap: 12px;
  }

  .socials a {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
    color: var(--black);
    border-radius: 4px;
  }

  .copyright-bar {
    background: var(--red);
    text-align: center;
    padding: 12px;
  }

  .copyright-bar p {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
