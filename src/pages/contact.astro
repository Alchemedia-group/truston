---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const address = 'TrustOn Ltd, 107 Rivermead Business Centre, Rivermead Dr, Swindon SN5 7EX';
const mapQuery = encodeURIComponent(address);

const cards = [
  {
    title: 'Chat to us',
    desc: 'Our team are here to discuss your specific requirements.',
    detail: 'info@truston.co.uk',
    href: 'mailto:info@truston.co.uk',
    icon: '<path d="M4 4h16v13H8l-4 4V4z"/>',
  },
  {
    title: 'Visit Us',
    desc: null,
    detail: 'TrustOn Ltd, 107 Rivermead Business Centre, Rivermead Dr, Swindon SN5 7EX',
    href: null,
    icon: '<path d="M12 22s7-7.58 7-13a7 7 0 0 0-14 0c0 5.42 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/>',
  },
  {
    title: 'Call us',
    desc: 'Our office is manned Mon-Fri 8am – 5pm but our phones are answered 24/7.',
    detail: '01793 832591',
    href: 'tel:01793832591',
    icon: '<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>',
  },
];
---

<Layout title="Contact Us | TrustOn Security Systems" description="For more information on all our services please get in touch and a member of the team will be happy to discuss your specific requirements.">
  <Header />

  <main>
    <!-- Info cards -->
    <section class="contact-cards">
      <div class="container contact-intro-inner">
        <h1>Get In Touch</h1>
        <p>
          For more information on all our services please get in touch and a member of the team
          will be happy to discuss your specific requirements.
        </p>
      </div>
      <div class="container contact-cards-grid">
        {cards.map((card) => (
          <div class="contact-card">
            <svg class="contact-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={card.icon} />
            <h2>{card.title}</h2>
            {card.desc && <p class="contact-card-desc">{card.desc}</p>}
            {card.href ? (
              <a class="contact-card-detail" href={card.href}>{card.detail}</a>
            ) : (
              <p class="contact-card-detail">{card.detail}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Map -->
    <section class="contact-map">
      <div class="container">
        <iframe
          class="contact-map-embed"
          title="TrustOn Ltd location"
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>

    <!-- Contact form -->
    <section class="contact-form-section">
      <div class="container">
        <h2 class="contact-form-title">Send us a message</h2>
        <form class="contact-form" id="contact-form">
          <div class="contact-form-grid">
            <label class="field">
              <span>First Name <span class="required">*</span></span>
              <input type="text" name="first-name" required />
            </label>
            <label class="field">
              <span>Last Name <span class="required">*</span></span>
              <input type="text" name="last-name" required />
            </label>
            <label class="field">
              <span>Email <span class="required">*</span></span>
              <input type="email" name="email" required />
            </label>
            <label class="field">
              <span>Phone</span>
              <input type="tel" name="phone" />
            </label>
          </div>
          <label class="field field-full">
            <span>Message <span class="required">*</span></span>
            <textarea name="message" rows="5" required></textarea>
          </label>
          <button type="submit" class="btn">Send Message</button>
        </form>
        <div class="contact-form-confirmation" id="contact-form-confirmation" hidden>
          <p>Thanks — your message is on its way.</p>
          <p class="confirmation-sub">A member of the team will be in touch shortly.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact-intro-inner {
    max-width: 700px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .contact-intro-inner h1 {
    margin-bottom: 16px;
  }

  .contact-intro-inner p {
    color: var(--white);
    line-height: 1.7;
  }

  .contact-cards {
    padding: 64px 0;
  }

  .contact-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .contact-card {
    background: var(--near-black);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
  }

  .contact-card-icon {
    width: 44px;
    height: 44px;
    color: var(--red);
    margin: 0 auto 16px;
  }

  .contact-card h2 {
    font-size: 1.2rem;
    margin-bottom: 12px;
  }

  .contact-card-desc {
    color: var(--gray-text);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .contact-card-detail {
    display: block;
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    line-height: 1.5;
  }

  a.contact-card-detail:hover {
    color: var(--red);
  }

  .contact-map {
    padding: 0 0 64px;
  }

  .contact-map-embed {
    width: 100%;
    height: 420px;
    border: 0;
    border-radius: 15px;
    display: block;
  }

  .contact-form-section {
    background: var(--near-black);
    padding: 64px 0;
  }

  .contact-form-title {
    text-align: center;
    margin-bottom: 32px;
  }

  .contact-form {
    background: var(--white);
    color: var(--black);
    max-width: 720px;
    margin: 0 auto;
    padding: 32px;
    border-radius: 12px;
  }

  .contact-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.9rem;
    margin-bottom: 16px;
  }

  .field-full {
    margin-bottom: 24px;
  }

  .field input,
  .field textarea {
    padding: 10px 12px;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    resize: vertical;
  }

  .required {
    color: var(--red);
  }

  .contact-form-confirmation {
    background: var(--white);
    color: var(--black);
    max-width: 720px;
    margin: 0 auto;
    padding: 32px;
    border-radius: 12px;
    text-align: center;
  }

  .contact-form-confirmation p {
    margin: 0 0 8px;
    font-weight: 600;
  }

  .confirmation-sub {
    color: #4a4a4a;
    font-weight: 400 !important;
  }

  @media (max-width: 900px) {
    .contact-cards-grid {
      grid-template-columns: 1fr;
    }

    .contact-form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const confirmation = document.getElementById('contact-form-confirmation') as HTMLElement;

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    form.hidden = true;
    confirmation.hidden = false;
  });
</script>
