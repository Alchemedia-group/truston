---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const columns = [
  [
    {
      type: 'video',
      src: 'https://truston.co.uk/wp-content/uploads/2025/09/What-is-Martyns-Law.mp4',
      poster: 'https://truston.co.uk/wp-content/uploads/2025/09/Screenshot-2025-09-05-at-10.07.46.png',
    },
    { type: 'youtube', id: 'WwUxMZ-CGzI' },
    { type: 'youtube', id: 'YIADI_-8JZ0' },
    { type: 'youtube', id: 'WDiv-PwEde4' },
  ],
  [
    {
      type: 'video',
      src: 'https://truston.co.uk/wp-content/uploads/2025/09/martyns_law_v1.3.mp4',
      poster: 'https://truston.co.uk/wp-content/uploads/2025/09/Screenshot-2025-09-05-at-10.07.20.png',
    },
    { type: 'youtube', id: 'raJkeT2l1Ys' },
    { type: 'youtube', id: 'RsCiAQXQTgc' },
    { type: 'youtube', id: 'qkgN4Bwhpf8' },
  ],
];
---

<Layout title="Protecting Communities | TrustOn Security Systems" description="Videos on protecting communities and Martyn's Law from TrustOn Security Systems.">
  <Header />

  <main>
    <section class="pc-intro">
      <div class="container">
        <h1>Protecting Communities</h1>
      </div>
    </section>

    <section class="pc-videos">
      <div class="container pc-columns">
        {columns.map((column) => (
          <div class="pc-column">
            {column.map((item) => (
              <div class="pc-video-wrap">
                {item.type === 'video' ? (
                  <video controls preload="none" poster={item.poster}>
                    <source src={item.src} type="video/mp4" />
                    Your browser does not support the video tag.
                  </video>
                ) : (
                  <iframe
                    loading="lazy"
                    src={`https://www.youtube.com/embed/${item.id}`}
                    title="YouTube video player"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  ></iframe>
                )}
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .pc-intro {
    background: var(--near-black);
    padding: 64px 0;
    text-align: center;
  }

  .pc-videos {
    background: var(--black);
    padding: 0 0 64px;
  }

  .pc-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .pc-column {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .pc-video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 15px;
    overflow: hidden;
    background: #000;
  }

  .pc-video-wrap video,
  .pc-video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 900px) {
    .pc-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
