---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';

const columns = [
  [
    {
      type: 'video',
      src: 'https://truston.co.uk/wp-content/uploads/2025/09/What-is-Martyns-Law.mp4',
      poster: 'https://truston.co.uk/wp-content/uploads/2025/09/Screenshot-2025-09-05-at-10.07.46.png',
    },
    { type: 'youtube', id: 'WwUxMZ-CGzI' },
    { type: 'youtube', id: 'YIADI_-8JZ0' },
    { type: 'youtube', id: 'WDiv-PwEde4' },
  ],
  [
    {
      type: 'video',
      src: 'https://truston.co.uk/wp-content/uploads/2025/09/martyns_law_v1.3.mp4',
      poster: 'https://truston.co.uk/wp-content/uploads/2025/09/Screenshot-2025-09-05-at-10.07.20.png',
    },
    { type: 'youtube', id: 'raJkeT2l1Ys' },
    { type: 'youtube', id: 'RsCiAQXQTgc' },
    { type: 'youtube', id: 'qkgN4Bwhpf8' },
  ],
];
---

<Layout title="Protecting Communities | TrustOn Security Systems" description="Videos on protecting communities and Martyn's Law from TrustOn Security Systems.">
  <Header />

  <main>
    <section class="pc-intro">
      <div class="container">
        <h1>Protecting Communities</h1>
      </div>
    </section>

    <section class="pc-videos">
      <div class="container pc-columns">
        {columns.map((column) => (
          <div class="pc-column">
            {column.map((item) => (
              <div class="pc-video-wrap">
                {item.type === 'video' ? (
                  <video controls preload="none" poster={item.poster}>
                    <source src={item.src} type="video/mp4" />
                    Your browser does not support the video tag.
                  </video>
                ) : (
                  <iframe
                    loading="lazy"
                    src={`https://www.youtube.com/embed/${item.id}`}
                    title="YouTube video player"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  ></iframe>
                )}
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- Detail -->
    <section class="detail">
      <div class="container detail-inner">
        <h2>Understanding Martyn's Law.</h2>
        <p>
          Martyn's Law introduces new legal responsibilities for many venues and events to plan
          and prepare for the possibility of a terrorist attack.
        </p>
        <p>
          TrustOn can help you understand what these changes mean for your premises and put the
          right measures in place.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="container">
        <h2>Need help meeting your obligations?</h2>
        <p>Speak to our team about how Martyn's Law affects your venue and what a compliant security plan looks like.</p>
        <p>Simply fill out the form, and our team of experts will respond as quickly as possible.</p>
        <button type="button" class="btn" data-open-quote>Start your bespoke quote</button>
      </div>
    </section>
  </main>

  <Footer />
  <QuoteModal />
</Layout>

<style>
  .pc-intro {
    background: var(--near-black);
    padding: 64px 0;
    text-align: center;
  }

  .pc-videos {
    background: var(--black);
    padding: 0 0 64px;
  }

  .pc-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .pc-column {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .pc-video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 15px;
    overflow: hidden;
    background: #000;
  }

  .pc-video-wrap video,
  .pc-video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 900px) {
    .pc-columns {
      grid-template-columns: 1fr;
    }
  }

  .detail {
    background: var(--near-black);
    padding: 64px 0;
  }

  .detail-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .detail-inner h2 {
    margin-bottom: 20px;
  }

  .detail-inner p {
    color: var(--gray-text);
    line-height: 1.7;
    text-align: left;
  }

  .cta {
    background: var(--white);
    color: var(--black);
    text-align: center;
    padding: 80px 0;
  }

  .cta h2 {
    color: var(--black);
    margin-bottom: 16px;
  }

  .cta p {
    color: #4a4a4a;
    max-width: 600px;
    margin: 0 auto 8px;
  }

  .cta .btn {
    margin-top: 24px;
  }
</style>
