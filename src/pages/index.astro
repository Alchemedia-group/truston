---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { getMedia, isVideo } from '../lib/media';

const sectors = [
  { label: 'Vacant Property', media: 'Truston Vacant Property Security', desc: 'An empty property shouldn’t be an easy target.' },
  { label: 'Construction', media: 'Truston Construction Security', desc: 'Don’t let theft, trespass or vandalism delay your next deadline.' },
  { label: 'Farms', media: 'Truston Farm Security', desc: 'Protect your land, livestock and equipment from those who shouldn’t be there.' },
  { label: 'Retail', media: 'Truston Retail Security', desc: 'Protect your people, premises and profits, day and night.' },
  { label: 'Homes', media: 'Truston Home Security', desc: 'Your home should feel safe, even when you’re not there.', href: '/our-systems/home-systems' },
];

const systems = [
  {
    label: 'Intrusion Detection',
    media: 'Intrusion Detection',
    href: '/our-systems/intrusion-detection',
    desc: 'A wide range of smart indoor and outdoor Ajax devices operate as a unified force to ensure protection against potential intrusion and deliver the best-in-class user experience.',
  },
  {
    label: 'Perimeter Protection',
    media: 'Perimeter Protection',
    href: '/our-systems/perimeter-protection',
    desc: 'Experience award-winning products, indoor and outdoor solutions, operating as a unified force to ensure protection against potential intrusion all in one smart ecosystem.',
  },
  {
    label: 'Video Surveillance',
    media: 'Video Surveillance',
    href: '/our-systems/video-surveillance',
    desc: 'With cutting-edge technology and unparalleled reliability, AJAX surveillance solutions provide crystal-clear, real-time monitoring to protect your home, business and loved ones.',
  },
  {
    label: 'Intelligent Access Systems',
    media: 'Intelligent access systems',
    href: '/our-systems/intelligent-access-systems',
    desc: 'Embrace the future of secure access management and experience the freedom of worry-free key storage. Combine technology with robust design ensuring durability.',
  },
  {
    label: 'Fire & Life Safety',
    media: 'Fire And Life Safety',
    href: '/our-systems/fire-and-life-safety',
    desc: 'Fire and life safety devices combine patented technologies, connectivity, ease of installation, and compliance with the most stringent international regulations.',
  },
  {
    label: 'Comfort & Automation',
    media: 'Comfort and Automation',
    href: '/our-systems/comfort-and-automation',
    desc: 'Enable users to control lighting and appliances, detect water leaks, manage water supply, and monitor air quality. Through automation, these devices reinforce on-site security.',
  },
];

const heroMedia = getMedia('Home page Hero');
const ajaxTvMedia = getMedia('Get Started With Ajax');
---

<Layout title="TrustOn Security Systems | Intelligent Security Solutions" description="Protect your home and business with intelligent security systems designed for complete peace of mind. Licensed Ajax Systems Partner.">
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero">
      {heroMedia ? (
        <img class="hero-bg" src={heroMedia} alt="" aria-hidden="true" />
      ) : (
        <div class="placeholder-media hero-bg" aria-hidden="true">Security equipment photo</div>
      )}
      <div class="container hero-inner">
        <div class="hero-copy">
          <h1>Professional Security Solutions</h1>
          <p>
            Protect your home and business with intelligent security systems designed for
            complete peace of mind. As a licensed Ajax Systems Partner, TrustOn delivers
            professional installation, AI-powered video surveillance, intrusion detection, fire
            protection, and smart automation tailored to your needs.
          </p>
          <ul class="checklist">
            <li>Authorised Ajax Installer</li>
            <li>Professional Installation</li>
            <li>Bespoke Security Solutions</li>
          </ul>
          <a class="btn" href="#quote-form">Start your bespoke quote</a>
        </div>
      </div>
    </section>

    <!-- Sector cards -->
    <section class="sectors">
      <div class="container sector-grid">
        {sectors.map((sector) => {
          const media = getMedia(sector.media);
          const CardTag = sector.href ? 'a' : 'div';
          return (
            <CardTag class="sector-card" {...(sector.href ? { href: sector.href } : {})}>
              {media ? (
                isVideo(media) ? (
                  <video class="sector-media" src={media} style="aspect-ratio: 4/3;" autoplay muted loop playsinline />
                ) : (
                  <img class="sector-media" src={media} alt={sector.label} style="aspect-ratio: 4/3;" loading="lazy" />
                )
              ) : (
                <div class="placeholder-media" style="aspect-ratio: 4/3;">{sector.label} photo</div>
              )}
              <h3>{sector.label}</h3>
              <p>{sector.desc}</p>
            </CardTag>
          );
        })}
      </div>
    </section>

    <!-- Our Systems -->
    <section class="systems">
      <div class="container systems-container">
        <h2 class="section-title">Our Systems</h2>
        <div class="systems-grid">
          {systems.map((system) => {
            const media = getMedia(system.media);
            return (
              <a class="system-card" href={system.href}>
                {media ? (
                  isVideo(media) ? (
                    <video class="system-media" src={media} style="aspect-ratio: 16/10;" autoplay muted loop playsinline />
                  ) : (
                    <img class="system-media" src={media} alt={system.label} style="aspect-ratio: 16/10;" loading="lazy" />
                  )
                ) : (
                  <div class="placeholder-media" style="aspect-ratio: 16/10;">{system.label} photo</div>
                )}
                <h3>{system.label}</h3>
                <p>{system.desc}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Ajax TV -->
    <section class="ajax-tv">
      <div class="container ajax-tv-inner">
        {ajaxTvMedia ? (
          <video class="video-placeholder" src={ajaxTvMedia} style="aspect-ratio: 16/9;" autoplay muted loop playsinline />
        ) : (
          <div class="placeholder-media video-placeholder" style="aspect-ratio: 16/9;">
            Video surveillance brought to the TV screen
          </div>
        )}
        <div class="ajax-tv-copy">
          <h2>Get started with Ajax TV</h2>
          <p>
            Ajax TV app displays live camera feeds in real time, making large-screen viewing
            convenient for daily monitoring at residential or commercial sites. The app is
            available for Android TV devices, and works without extra hardware or complex setup.
          </p>
          <h3>Smooth integration within the Ajax ecosystem</h3>
          <p>
            Ajax TV is synchronized with other Ajax apps, allowing access to live video feeds
            directly on the TV screen without requiring additional setup. All system management
            and configuration remain in mobile and desktop apps.
          </p>
        </div>
      </div>
    </section>

    <!-- Detail -->
    <section class="detail">
      <div class="container detail-inner">
        <h2>One system. Every part of your property.</h2>
        <p>
          From a family home to a working farm, retail unit, construction site or vacant
          property, TrustOn brings intrusion detection, video surveillance, access control, fire
          and life safety and automation together in one connected system.
        </p>
        <p>
          Everything has a purpose: detect earlier, verify faster, and put the right information
          in your hands - or ours - the moment it matters.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="container">
        <h2>Ready to get started?</h2>
        <p>Need advice on the right security system for your home or business?</p>
        <p>Simply fill out the form, and our team of experts will respond as quickly as possible to address your security needs.</p>
        <a class="btn" href="#quote-form">Start your bespoke quote</a>
      </div>
    </section>

    <!-- Free Quotation -->
    <QuoteForm />
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    background: var(--near-black);
    padding: 96px 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-copy {
    max-width: 560px;
  }

  .hero-copy p {
    color: var(--gray-text);
    line-height: 1.7;
  }

  .checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }

  .checklist li {
    color: var(--gray-text);
    padding: 4px 0;
  }

  .checklist li::before {
    content: '\2713';
    color: var(--red);
    margin-right: 8px;
    font-weight: 700;
  }

  .sectors {
    padding: 48px 0;
  }

  .sector-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .sector-card {
    min-width: 0;
    display: block;
    text-decoration: none;
  }

  a.sector-card:hover h3 {
    color: var(--red);
  }

  .sector-media {
    width: 100%;
    object-fit: cover;
    border-radius: 15px;
  }

  .sector-card h3 {
    font-size: 1rem;
    margin: 12px 0 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sector-card p {
    color: var(--gray-text);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .systems {
    padding: 48px 0 64px;
  }

  .systems-container {
    max-width: 1400px;
  }

  .section-title {
    text-align: center;
    margin-bottom: 32px;
  }

  .systems-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .system-card {
    text-decoration: none;
    color: inherit;
  }

  .system-media {
    width: 100%;
    object-fit: cover;
    border-radius: 15px;
  }

  .system-card h3 {
    font-size: 1.1rem;
    margin: 12px 0 6px;
  }

  .system-card p {
    color: var(--gray-text);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .ajax-tv {
    background: var(--black);
    padding: 64px 0;
  }

  .ajax-tv-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .video-placeholder {
    width: 100%;
    border-radius: 15px;
  }

  .ajax-tv-copy p {
    color: var(--gray-text);
    line-height: 1.7;
  }

  .ajax-tv-copy h2 {
    margin-bottom: 12px;
  }

  .ajax-tv-copy h3 {
    margin: 16px 0 8px;
  }

  @media (max-width: 900px) {
    .ajax-tv-inner {
      grid-template-columns: 1fr;
    }

    .systems-grid {
      grid-template-columns: 1fr;
    }
  }

  .detail {
    background: var(--near-black);
    padding: 64px 0;
  }

  .detail-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .detail-inner h2 {
    margin-bottom: 20px;
  }

  .detail-inner p {
    color: var(--gray-text);
    line-height: 1.7;
    text-align: left;
  }

  .cta {
    background: var(--white);
    color: var(--black);
    text-align: center;
    padding: 80px 0;
  }

  .cta h2 {
    color: var(--black);
    margin-bottom: 16px;
  }

  .cta p {
    color: #4a4a4a;
    max-width: 600px;
    margin: 0 auto 8px;
  }

  .cta .btn {
    margin-top: 24px;
  }
</style>
