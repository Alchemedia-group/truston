---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';
import { getMedia } from '../lib/media';

const values = [
  {
    title: 'Integrity - Security you can trust',
    desc: 'We give clear, honest advice and recommend solutions based on what our customers genuinely need. From system design to installation and ongoing support, we take responsibility for doing things properly.',
    media: 'Integrity',
  },
  {
    title: 'Innovation - Technology with purpose.',
    desc: 'We embrace new technology when it makes security smarter, faster or more effective. Innovation isn’t about adding more devices; it’s about using the right technology together to deliver better protection.',
    media: 'Innovation',
  },
  {
    title: 'Clarity - Intelligent doesn’t have to mean complicated.',
    desc: 'Security technology can be sophisticated without being difficult to understand. We cut through the jargon, explain what matters and make intelligent security straightforward to use and manage.',
    media: 'Clarity',
  },
  {
    title: 'Resilience - Ready when it matters.',
    desc: 'Security has to perform when something goes wrong. We design dependable, adaptable systems around real risks, giving our customers confidence that their protection is working today and can evolve with their needs tomorrow.',
    media: 'Resilience',
  },
];

const stats = [
  { label: 'Constantly Evolving', media: 'constantly evolving' },
  { label: '24/7:365', media: '24 7' },
  { label: 'First Class Service', media: 'first class service' },
  { label: 'Bespoke Solutions', media: 'Bespoke' },
  { label: 'Competitive Rates', media: 'competitive rates' },
  { label: 'Rapid Deployment', media: 'rapid deployment' },
];

const heroMedia = getMedia('Truston Van');
const missionMedia = getMedia('Mission statement');

const testimonials = [
  {
    quote: 'TrustOn were so quick to get a Siteguard on our site when we had a problem! Rang them Friday morning and it was operational by the weekend',
    author: 'Client',
    date: 'March 2026',
  },
  {
    quote: 'From the initial survey through to installation, TrustOn made everything straightforward. The Ajax system is incredibly easy to use, and the team took the time to make sure we understood exactly how everything worked.',
    author: 'Client',
    date: 'January 2026',
  },
  {
    quote: 'We wanted more than just an alarm. TrustOn designed an Ajax system around our property, combining detection, cameras and remote control into one simple solution. It feels like a completely different level of security',
    author: 'Client',
    date: 'August 2026',
  },
  {
    quote: 'The installation was tidy, professional and clearly explained. We now have instant alerts and complete visibility of the property wherever we are — with the reassurance that TrustOn is there if we ever need support',
    author: 'Client',
    date: 'December 2025',
  },
];
---

<Layout title="About Us | TrustOn Security Systems" description="TrustOn Security Systems is part of the wider TrustOn family, building on more than a decade of experience protecting homes, businesses and sites with trusted, professional security services.">
  <Header />

  <main>
    <!-- About hero -->
    <section class="about-hero">
      {heroMedia ? (
        <img class="about-hero-bg" src={heroMedia} alt="" aria-hidden="true" />
      ) : (
        <div class="placeholder-media about-hero-bg" aria-hidden="true">TrustOn van photo</div>
      )}
      <div class="about-hero-scrim" aria-hidden="true"></div>
      <div class="container about-hero-inner">
        <div class="about-copy">
          <h1>About Us</h1>
          <p>
            TrustOn Security Systems is part of the wider TrustOn family, building on more than
            a decade of experience protecting homes, businesses and sites with trusted,
            professional security services. We bring together intelligent technology, expert
            system design and the wider capabilities of TrustOn - including monitoring,
            keyholding, alarm response, mobile patrols and on-site security - to create joined-up
            solutions built around each customer and their risks. Rather than simply installing
            equipment, we look at the whole picture, combining smart security systems with the
            people, support and response behind them to deliver protection that is simple to
            use, dependable and designed for the real world.
          </p>
        </div>
      </div>
    </section>

    <!-- Mission & Values -->
    <section class="mission-values">
      <div class="container mission-values-grid">
        <div class="mission">
          <h2>Mission<br /><span class="accent">Statement</span></h2>
          <div class="mission-icon" aria-hidden="true">
            {missionMedia ? (
              <img src={missionMedia} alt="" width="80" height="80" />
            ) : (
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z" />
                <circle cx="12" cy="11" r="3" />
              </svg>
            )}
          </div>
          <p>
            TrustOn Security Systems combines proven technology, expert design and local
            knowledge to create integrated security solutions built around real-world risks. We
            protect people, property and everyday life with systems that are easy to understand,
            simple to use and ready when they're needed most.
          </p>
        </div>

        <div class="values">
          <h2>Our<br /><span class="accent">Values</span></h2>
          <ul class="values-list">
            {values.map((value) => {
              const media = getMedia(value.media);
              return (
                <li>
                  <div class="value-icon" aria-hidden="true">
                    {media ? (
                      <img src={media} alt="" width="56" height="56" />
                    ) : (
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                    )}
                  </div>
                  <div>
                    <h3>{value.title}</h3>
                    <p>{value.desc}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>

    <!-- Backed by TrustOn stats -->
    <section class="stats">
      <div class="container">
        <h2 class="stats-title">Intelligent security. Designed around you.</h2>
        <p class="stats-subtitle">Backed by TrustOn</p>
        <div class="stats-grid">
          {stats.map((stat) => {
            const media = getMedia(stat.media);
            return (
              <div class="stat-item">
                <div class="stat-icon" aria-hidden="true">
                  {media ? (
                    <img src={media} alt="" width="64" height="64" />
                  ) : (
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <circle cx="12" cy="12" r="9" />
                    </svg>
                  )}
                </div>
                <p>{stat.label}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section id="testimonials" class="testimonials">
      <div class="container">
        <h2 class="testimonials-title">Testimonials</h2>
        <p class="testimonials-subtitle">
          We take pride in delivering security solutions that make a real difference. Here's what
          our clients have to say about working with TrustOn Security Systems
        </p>

        <div class="testimonials-carousel">
          <button type="button" class="carousel-arrow" id="testimonial-prev" aria-label="Previous testimonial">&#10094;</button>
          <div class="testimonials-track" id="testimonials-track">
            {[0, 1, 2].map((slot) => (
              <div class="testimonial-card" data-slot={slot}>
                <p class="quote">{testimonials[slot].quote}</p>
                <p class="author">{testimonials[slot].author}</p>
                <p class="date">{testimonials[slot].date}</p>
              </div>
            ))}
          </div>
          <button type="button" class="carousel-arrow" id="testimonial-next" aria-label="Next testimonial">&#10095;</button>
        </div>
      </div>
    </section>

    <!-- Detail -->
    <section class="detail">
      <div class="container detail-inner">
        <h2>Technology backed by a team you can rely on.</h2>
        <p>
          Being an Authorised Ajax Installer means every system we design and install meets the
          same professional standard, whatever the property or the risk.
        </p>
        <p>
          But equipment alone isn't security. Our team is here before, during and after
          installation - so you always know who to call.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="container">
        <h2>Ready to work with TrustOn?</h2>
        <p>Want to find out more about how we work, or get a quote for your property?</p>
        <p>Simply fill out the form, and our team of experts will respond as quickly as possible.</p>
        <button type="button" class="btn" data-open-quote>Start your bespoke quote</button>
      </div>
    </section>
  </main>

  <Footer />
  <QuoteModal />
</Layout>

<style>
  .about-hero {
    position: relative;
    background: var(--near-black);
    padding: 96px 0;
    overflow: hidden;
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-hero-scrim {
    display: none;
  }

  .about-hero-inner {
    position: relative;
    z-index: 1;
  }

  .about-copy {
    max-width: 390px;
  }

  .about-copy h1 {
    color: var(--white);
    margin-bottom: 8px;
    border-bottom: 3px solid var(--red);
    display: inline-block;
    padding-bottom: 8px;
  }

  .about-copy p {
    color: var(--white);
    line-height: 1.7;
    margin-top: 20px;
  }

  .mission-values {
    padding: 64px 0;
  }

  .mission-values-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
  }

  .mission h2,
  .values h2 {
    font-size: 1.8rem;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .accent {
    color: var(--red);
  }

  .mission-icon {
    color: var(--red);
    margin-bottom: 16px;
  }

  .mission p {
    color: var(--gray-text);
    line-height: 1.7;
  }

  .values-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .values-list li {
    display: flex;
    gap: 16px;
  }

  .value-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    color: var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .value-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .values-list h3 {
    font-size: 1rem;
    margin: 0 0 6px;
  }

  .values-list p {
    color: var(--gray-text);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  .stats {
    background: var(--near-black);
    padding: 64px 0;
    text-align: center;
  }

  .stats-title {
    margin-bottom: 8px;
  }

  .stats-subtitle {
    color: var(--red);
    font-weight: 700;
    font-size: 1.2rem;
    margin: 0 0 40px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
  }

  .stat-icon {
    color: var(--red);
    margin: 0 auto 12px;
    width: fit-content;
  }

  .stat-item p {
    font-size: 0.85rem;
    color: var(--gray-text);
  }

  .testimonials {
    padding: 64px 0;
    text-align: center;
  }

  .testimonials-title {
    margin-bottom: 12px;
  }

  .testimonials-subtitle {
    color: var(--gray-text);
    max-width: 700px;
    margin: 0 auto 40px;
  }

  .testimonials-carousel {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .carousel-arrow {
    background: none;
    border: none;
    color: var(--white);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 8px;
  }

  .testimonials-track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    flex: 1;
  }

  .testimonial-card {
    transition: opacity 0.2s ease;
  }

  .testimonial-card.fading {
    opacity: 0;
  }

  .testimonial-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    text-align: left;
  }

  .testimonial-card .quote {
    color: var(--gray-text);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .testimonial-card .author {
    margin: 0;
    color: var(--gray-text);
    font-size: 0.9rem;
  }

  .testimonial-card .date {
    margin: 4px 0 0;
    color: var(--red);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .about-hero-scrim {
      display: block;
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(13, 13, 15, 0.35) 0%, rgba(13, 13, 15, 0.85) 60%, rgba(13, 13, 15, 0.92) 100%);
    }

    .mission-values-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .testimonials-track {
      grid-template-columns: 1fr;
    }

    .testimonial-card[data-slot="1"],
    .testimonial-card[data-slot="2"] {
      display: none;
    }
  }

  .detail {
    background: var(--near-black);
    padding: 64px 0;
  }

  .detail-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .detail-inner h2 {
    margin-bottom: 20px;
  }

  .detail-inner p {
    color: var(--gray-text);
    line-height: 1.7;
    text-align: left;
  }

  .cta {
    background: var(--white);
    color: var(--black);
    text-align: center;
    padding: 80px 0;
  }

  .cta h2 {
    color: var(--black);
    margin-bottom: 16px;
  }

  .cta p {
    color: #4a4a4a;
    max-width: 600px;
    margin: 0 auto 8px;
  }

  .cta .btn {
    margin-top: 24px;
  }
</style>

<script define:vars={{ testimonials }}>
  const track = document.getElementById('testimonials-track');
  const prevBtn = document.getElementById('testimonial-prev');
  const nextBtn = document.getElementById('testimonial-next');
  const cards = Array.from(track.querySelectorAll('.testimonial-card'));

  const total = testimonials.length;
  let startIndex = 0;

  function render() {
    cards.forEach((card, slot) => {
      const t = testimonials[(startIndex + slot) % total];
      card.querySelector('.quote').textContent = t.quote;
      card.querySelector('.author').textContent = t.author;
      card.querySelector('.date').textContent = t.date;
    });
  }

  function slide(direction) {
    cards.forEach((card) => card.classList.add('fading'));
    setTimeout(() => {
      startIndex = (startIndex + direction + total) % total;
      render();
      cards.forEach((card) => card.classList.remove('fading'));
    }, 200);
  }

  prevBtn.addEventListener('click', () => slide(-1));
  nextBtn.addEventListener('click', () => slide(1));
</script>
