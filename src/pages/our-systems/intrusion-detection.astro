---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuoteModal from '../../components/QuoteModal.astro';
import { getMedia, isVideo } from '../../lib/media';

const features = [
  { label: 'Visual verification of alarms', media: 'Visual Verification Of Alarms(1)' },
  { label: 'Connection to the Ajax Approved Monitoring Centre', media: 'connect to the central monitoring station' },
  { label: 'Instant alarm at the push of a panic button or duress code', media: 'Instant Alarm At The Push Of A Button Or Duress Code(1)' },
];

const packageOptions = [
  {
    label: 'Monitoring',
    desc: 'Round-the-clock monitoring by a professional alarm receiving centre.',
    icon: '<circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>',
  },
  {
    label: 'Keyholding',
    desc: 'Secure keyholding so a trusted responder can access your property when it matters.',
    icon: '<circle cx="8" cy="12" r="4"/><path d="M12 12h9M17 12v4M20 12v3"/>',
  },
  {
    label: 'Alarm Response',
    desc: "A rapid, professional response the moment a genuine alarm is confirmed.",
    icon: '<path d="M12 3a6 6 0 0 0-6 6c0 5-2 6-2 6h16s-2-1-2-6a6 6 0 0 0-6-6z"/><path d="M10 20a2 2 0 0 0 4 0"/>',
  },
  {
    label: 'CCTV',
    desc: 'Live and recorded video evidence to verify exactly what is happening.',
    icon: '<rect x="2" y="7" width="14" height="10" rx="2"/><path d="M16 10l5-3v10l-5-3z"/>',
  },
  {
    label: 'Mobile Security',
    desc: 'Mobile patrols providing a visible, physical presence on site.',
    icon: '<rect x="3" y="11" width="18" height="6" rx="2"/><path d="M5 11l2-5h10l2 5"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/>',
  },
];

const heroVideo = getMedia('Intruder Detection(1)');
const introMedia = getMedia('intruder intro');

const homeRenderMedia = getMedia('Homes Render');
const homeHotspots = [
  { x: 37, y: 8, title: 'Central Hub', description: 'Hotspot info coming soon.' },
  { x: 50, y: 10, title: 'Motion Detector', description: 'Hotspot info coming soon.' },
  { x: 35, y: 20, title: 'Exterior Camera', description: 'Hotspot info coming soon.' },
  { x: 58, y: 20, title: 'Video Intercom', description: 'Hotspot info coming soon.' },
  { x: 56, y: 29, title: 'Keypad', description: 'Hotspot info coming soon.' },
  { x: 46, y: 39, title: 'Door & Window Sensors', description: 'Hotspot info coming soon.' },
  { x: 41, y: 64, title: 'Video Doorbell', description: 'Hotspot info coming soon.' },
  { x: 79, y: 43, title: 'Garage Sensor', description: 'Hotspot info coming soon.' },
];
---

<Layout title="Intrusion Detection | TrustOn Security Systems" description="An alarm should do more than make a noise. Intrusion detection systems from TrustOn Security Systems, designed around your property and the risks you actually face.">
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero">
      {heroVideo ? (
        <video class="hero-media" src={heroVideo} autoplay muted loop playsinline aria-hidden="true" />
      ) : (
        <div class="placeholder-media hero-media" aria-hidden="true">Intrusion detection video</div>
      )}
      <div class="hero-overlay">
        <h1>Intrusion Detection</h1>
        <div class="divider"></div>
        <p>An alarm should do more than make a noise.</p>
        <button type="button" class="btn" data-open-quote>Start your bespoke quote</button>
      </div>
    </section>

    <!-- Intro -->
    <section class="intro">
      <div class="container intro-grid">
        <div class="copy">
          <p>
            Designed around your property, the way it is used and the risks you actually face. We
            can protect doors, windows, internal spaces and external areas, combining intelligent
            detection with instant alerts and visual verification to give you a clearer picture of
            what is happening.
          </p>
          <p>
            The result is a security system that doesn't simply tell you something has happened -
            it helps establish what has happened and what needs to happen next.
          </p>
          <p>
            Ajax can combine opening detection, motion detection, outdoor perimeter protection and
            photo verification within the wider security system.
          </p>
        </div>
        {introMedia ? (
          isVideo(introMedia) ? (
            <video class="intro-media" src={introMedia} style="aspect-ratio: 4/3;" autoplay muted loop playsinline />
          ) : (
            <img class="intro-media" src={introMedia} alt="Intrusion detection" style="aspect-ratio: 4/3;" loading="lazy" />
          )
        ) : (
          <div class="placeholder-media intro-media" style="aspect-ratio: 4/3;">Intrusion detection photo</div>
        )}
      </div>

      <div class="container feature-grid">
        {features.map((feature) => {
          const media = getMedia(feature.media);
          return (
            <div class="feature-card">
              {media ? (
                isVideo(media) ? (
                  <video class="feature-media" src={media} style="aspect-ratio: 4/3;" autoplay muted loop playsinline />
                ) : (
                  <img class="feature-media" src={media} alt={feature.label} style="aspect-ratio: 4/3;" loading="lazy" />
                )
              ) : (
                <div class="placeholder-media" style="aspect-ratio: 4/3;">{feature.label} photo</div>
              )}
              <p>{feature.label}</p>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Home protection hotspots -->
    <section class="home-render-section">
      <div class="container">
        <div class="home-render-header">
          <h2>See how your home is protected</h2>
          <p>Explore the hotspots below to learn how intrusion detection covers every part of your property.</p>
        </div>

        <div class="render-stage">
          <div class="render-wrap">
            {homeRenderMedia ? (
              <img class="render-image" src={homeRenderMedia} alt="Home security render" loading="lazy" />
            ) : (
              <div class="placeholder-media render-image" style="aspect-ratio: 1748 / 984;">Home render image</div>
            )}

            {homeHotspots.map((hotspot, index) => (
              <button
                type="button"
                class="hotspot"
                style={`left: ${hotspot.x}%; top: ${hotspot.y}%;`}
                data-index={index}
                aria-label={hotspot.title}
              >
                <span class="hotspot-pulse"></span>
              </button>
            ))}
          </div>

          <div class="hotspot-panel" id="hotspot-panel" data-empty="true">
            <p class="hotspot-panel-hint">Select a hotspot to learn more.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Protection backed by people -->
    <section class="backed-by-people">
      <div class="container">
        <div class="backed-header">
          <h2>Protection backed by people</h2>
          <p class="lead">Technology detects the problem. TrustOn helps deal with it.</p>
          <p>
            Depending on the level of protection you need, intrusion detection can form part of a
            wider TrustOn package incorporating monitoring, keyholding, alarm response, CCTV and
            mobile security.
          </p>
        </div>

        <div class="tile-grid">
          {packageOptions.map((option) => (
            <div class="tile">
              <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={option.icon} />
              <h3>{option.label}</h3>
              <p>{option.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="container">
        <h2>Ready to protect your facility?</h2>
        <p>Need advice on how to secure your home or business premises with an Ajax alarm system?</p>
        <p>Simply fill out the form, and our team of experts will respond as quickly as possible to address your alarm installation needs.</p>
        <button type="button" class="btn" data-open-quote>Start your bespoke quote</button>
      </div>
    </section>
  </main>

  <Footer />
  <QuoteModal />
</Layout>

<style>
  .hero {
    position: relative;
    height: 480px;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    padding: 120px 32px 0;
  }

  .hero-overlay h1 {
    background: rgba(13, 13, 15, 0.75);
    display: inline-block;
    padding: 16px 48px;
  }

  .divider {
    width: 80px;
    height: 3px;
    background: var(--red);
    margin: 16px auto;
  }

  .hero-overlay p {
    color: var(--white);
    margin: 0 0 24px;
    font-size: 1.1rem;
  }

  .intro {
    background: var(--black);
    padding: 64px 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
    margin-bottom: 48px;
  }

  .copy p {
    color: var(--gray-text);
    line-height: 1.7;
  }

  .intro-media {
    width: 100%;
    border-radius: 15px;
    object-fit: cover;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-media {
    width: 100%;
    border-radius: 15px;
    object-fit: cover;
  }

  .feature-card p {
    text-align: center;
    margin-top: 12px;
    font-weight: 600;
  }

  .home-render-section {
    background: var(--white);
    color: var(--black);
    padding: 64px 0;
  }

  .home-render-header {
    max-width: 640px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .home-render-header h2 {
    color: var(--black);
    margin-bottom: 12px;
  }

  .home-render-header p {
    color: #4a4a4a;
    line-height: 1.6;
  }

  .render-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .render-wrap {
    position: relative;
    display: inline-block;
    max-width: 960px;
    width: 100%;
  }

  .render-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 15px;
  }

  .hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--red);
    border: 3px solid var(--white);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    padding: 0;
    animation: hotspot-fade 2.4s ease-in-out infinite;
  }

  @keyframes hotspot-fade {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .hotspot-pulse {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--red);
    opacity: 0.6;
    animation: hotspot-pulse 2s ease-out infinite;
  }

  @keyframes hotspot-pulse {
    0% {
      transform: scale(0.8);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .hotspot.active {
    background: var(--red-dark);
    animation: none;
    opacity: 1;
  }

  .hotspot-panel {
    width: 100%;
    max-width: 960px;
    min-height: 88px;
    background: #f5f5f5;
    border: 1px solid #e2e2e2;
    border-radius: 12px;
    padding: 20px 24px;
  }

  .hotspot-panel[data-empty='true'] {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hotspot-panel-hint {
    color: #6a6a6a;
    margin: 0;
  }

  .hotspot-panel h3 {
    color: var(--black);
    margin-bottom: 8px;
  }

  .hotspot-panel p {
    color: #4a4a4a;
    line-height: 1.6;
    margin: 0;
  }

  .backed-by-people {
    background: var(--near-black);
    padding: 64px 0;
  }

  .backed-header {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .backed-header h2 {
    margin-bottom: 16px;
  }

  .backed-header .lead {
    color: var(--white);
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0 0 12px;
  }

  .backed-header > p {
    color: var(--gray-text);
    line-height: 1.7;
  }

  .tile-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
    margin-top: 40px;
    text-align: left;
  }

  .tile {
    background: var(--black);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
  }

  .tile-icon {
    width: 44px;
    height: 44px;
    color: var(--red);
    margin-bottom: 14px;
  }

  .tile h3 {
    font-size: 1rem;
    margin-bottom: 6px;
  }

  .tile p {
    color: var(--gray-text);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  .cta {
    background: var(--white);
    color: var(--black);
    text-align: center;
    padding: 80px 0;
  }

  .cta h2 {
    color: var(--black);
    margin-bottom: 16px;
  }

  .cta p {
    color: #4a4a4a;
    max-width: 600px;
    margin: 0 auto 8px;
  }

  .cta .btn {
    margin-top: 24px;
  }

  @media (max-width: 900px) {
    .intro-grid,
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .tile-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .hotspot {
      width: 18px;
      height: 18px;
      border-width: 2px;
    }

    .hotspot-pulse {
      inset: -5px;
    }
  }

  @media (max-width: 480px) {
    .tile-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ homeHotspots }}>
  const hotspotButtons = document.querySelectorAll('.hotspot');
  const panel = document.getElementById('hotspot-panel');

  hotspotButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const index = Number(button.dataset.index);
      const hotspot = homeHotspots[index];
      if (!hotspot) return;

      hotspotButtons.forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');

      panel.dataset.empty = 'false';
      panel.innerHTML = `<h3>${hotspot.title}</h3><p>${hotspot.description}</p>`;
    });
  });
</script>
